{
  "name": "mongo-workbench",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Irwin is a cross-platform MongoDB workspace for development teams",
  "author": {
    "name": "Wilbert Yang",
    "email": "zxpiayru@gmail.com"
  },
  "license": "MIT",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e:tooltips": "node tests/e2e/tooltips.mjs",
    "release:licenses": "node scripts/third-party-notices.mjs",
    "package": "pnpm release:licenses && pnpm build && node scripts/check-tools.mjs && node scripts/package.mjs",
    "package:dir": "pnpm release:licenses && pnpm build && node scripts/check-tools.mjs && node scripts/package.mjs --dir",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:verify": "node scripts/verify-package.mjs",
    "tools:fetch": "node scripts/fetch-tools.mjs"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@monaco-editor/react": "^4.7.0",
    "@mongosh/service-provider-node-driver": "5.2.0",
    "@mongosh/shell-api": "5.5.0",
    "@mongosh/shell-evaluator": "5.5.0",
    "@tanstack/react-virtual": "^3.14.11",
    "bson": "^7.3.2",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0",
    "lucide-react": "^1.43.0",
    "monaco-editor": "^0.56.0",
    "mongodb": "^7.6.0",
    "mongodb-connection-string-url": "^7.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ssh2": "^1.17.0",
    "stream-json": "^3.7.0",
    "zod": "^4.5.4"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "piayru",
        "repo": "irwin"
      }
    ],
    "npmRebuild": false,
    "appId": "dev.mongoworkbench.desktop",
    "productName": "Irwin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "build/third-party-licenses",
        "to": "third-party-licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/tools/${os}-${arch}",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "artifactName": "Irwin-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "artifactName": "Irwin-${version}-linux-${arch}.${ext}",
      "executableName": "irwin",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Wilbert Yang <zxpiayru@gmail.com>"
    },
    "deb": {
      "packageName": "irwin"
    },
    "mac": {
      "artifactName": "Irwin-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "minimumSystemVersion": "14.0",
      "category": "public.app-category.developer-tools"
    }
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "unzipper": "0.12.5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piayru/irwin.git"
  },
  "homepage": "https://github.com/piayru/irwin",
  "bugs": {
    "url": "https://github.com/piayru/irwin/issues"
  }
}
